{
  "name": "smart-edu-center",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:secrets": "node scripts/check-repository-secrets.mjs",
    "check:client-secrets": "node scripts/check-client-secrets.mjs",
    "check:runtime-dependencies": "node scripts/check-runtime-dependencies.mjs",
    "seed:capability-catalog": "node postgres/scripts/seed-capability-catalog.mjs",
    "seed:canonical-demo": "node postgres/scripts/seed-canonical-demo.mjs",
    "provision:app-role": "node postgres/scripts/provision-app-role.mjs",
    "backup:database": "node postgres/scripts/backup-database.mjs",
    "restore:drill": "node postgres/scripts/restore-drill.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run check:migrations && npm run check:secrets && npm run build && npm run check:client-secrets && npm run check:runtime-dependencies"
  },
  "dependencies": {
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
