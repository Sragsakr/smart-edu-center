# Server-only PostgreSQL connection string. Never expose it to the client or commit real credentials.
# Target runtime is PostgreSQL 18. The local development instance runs on port 5433.
#
# IMPORTANT: the runtime must connect as the dedicated application role, never as the
# database owner. Row-level security is NOT enforced for superusers or BYPASSRLS roles,
# so connecting as the owner silently disables tenant isolation. See docs/adr/0007.
# Provision the role with:  npm run provision:app-role
DATABASE_URL=postgresql://saboraty_app:change-me@127.0.0.1:5433/saboraty
# Owner connection, used only to apply the baseline, seed data and recreate the
# disposable test database. Never used by the running application.
MIGRATION_DATABASE_URL=postgresql://postgres:change-me@127.0.0.1:5433/saboraty
# Password for the application role. At least 16 characters, kept in the environment
# secret store outside development.
APP_DB_PASSWORD=change-me-at-least-16-chars
# Disposable database for `npm run test:integration` only. Must never equal DATABASE_URL or point at saboraty;
# the harness refuses to run otherwise. It is dropped and recreated from the baseline on every run.
TEST_DATABASE_URL=postgresql://postgres:change-me@127.0.0.1:5433/saboraty_test
